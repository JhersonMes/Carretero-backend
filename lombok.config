# Los controladores inyectan sus mappers por constructor generado con
# @RequiredArgsConstructor y los eligen con @Qualifier("clientMapper"), etc.
# Lombok no copia esa anotacion al parametro salvo que se le indique aqui, y sin
# ella Spring resolvia por tipo: como hay varios ModelMapper, siempre ganaba el
# @Primary y todos los controladores terminaban usando el mismo mapper generico,
# ignorando la configuracion propia de cada uno.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
